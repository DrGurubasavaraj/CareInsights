# Local PostgreSQL development
[postgres]
host = "localhost"
port = 5432
database = "hospital_analytics"
username = "postgres"
password = "CHANGE_ME"
sslmode = "prefer"

# For Streamlit Community Cloud with a managed PostgreSQL provider such as Neon,
# replace the fields above with a single provider connection URL instead:
#
# [postgres]
# url = "postgresql+psycopg2://USER:PASSWORD@HOST/DATABASE?sslmode=require"
